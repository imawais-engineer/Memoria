# --- LLM provider -------------------------------------------------------
# Any OpenAI-compatible API: set LLM_BASE_URL (and LLM_API_KEY). Leave
# LLM_BASE_URL empty to use DashScope (below). LLM_PROVIDER is optional:
# "openai" or "dashscope" (default: openai when LLM_BASE_URL is set).
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=your_key
LLM_CHAT_MODEL=
# Cheaper model for memory extraction / structured output (defaults to chat model)
LLM_FAST_MODEL=
LLM_EMBEDDING_MODEL=
# Comma separated models for the chat model switcher
LLM_CHAT_MODELS=
# Must match the pgvector column (1024 by default). See docs/EMBEDDINGS.md
EMBEDDING_DIM=1024
# LLM_EMBEDDING_SEND_DIMENSIONS=true   # for OpenAI text-embedding-3-*
# Example (Qwen OpenAI-compatible mode):
#   LLM_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1
#   LLM_CHAT_MODEL=qwen3.8-flash  LLM_EMBEDDING_MODEL=text-embedding-v3

# --- DashScope (native SDK; also required for image/video/voice) ----------
DASHSCOPE_API_KEY=your_key
# Optional alias accepted by the backend if DASHSCOPE_API_KEY is unset:
# QWEN_DASHSCOPE_API=your_key
# Optional: DashScope endpoint override (set to the intl endpoint for
# international-region keys). Leave blank for the SDK default (Beijing).
DASHSCOPE_BASE_URL=
DATABASE_URL=postgresql+asyncpg://user:pass@localhost/memoria
REDIS_URL=redis://localhost:6379/0
# Signs access tokens (HS256). Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Outside ENVIRONMENT=dev the app refuses to start with the default or a key under 32 chars.
SECRET_KEY=change-me-in-production
ENVIRONMENT=dev
# ACCESS_TOKEN_TTL_MINUTES=1440
# X-API-Token guard on destructive routes. Default: on in dev, off elsewhere.
# ALLOW_DEMO_TOKEN=true
# Per-user limits (0 disables). Counters use Redis, with in-memory fallback.
RATE_LIMIT_PER_MIN=30
DAILY_TOKEN_CAP=200000

# Per-kind importance decay per day (fact/event/preference)
DECAY_RATE_FACT=0.005
DECAY_RATE_EVENT=0.03
DECAY_RATE_PREFERENCE=0.01
