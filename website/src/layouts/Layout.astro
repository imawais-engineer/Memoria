---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SITE_URL, canonical, AUTHOR, GITHUB_URL, GITHUB_PROFILE_URL, DEFAULT_DESCRIPTION } from '../config';

interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/features"; "/" for home
  noindex?: boolean;
  breadcrumb?: string; // label of the current page; adds BreadcrumbList
  jsonLd?: object[];
}
const { title, description, path, noindex = false, breadcrumb, jsonLd = [] } = Astro.props;
const url = canonical(path === '/' ? '' : path) || SITE_URL;
const ogImage = `${SITE_URL}/og-image.png`;
const ogAlt = 'Memoria: self-evolving personal AI with human-like memory';
const crumbs = breadcrumb
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE_NAME, item: SITE_URL },
        { '@type': 'ListItem', position: 2, name: breadcrumb, item: url },
      ],
    }
  : null;
const blocks = [...jsonLd, ...(crumbs ? [crumbs] : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="application-name" content={SITE_NAME} />
    <meta name="theme-color" content="#0f1220" />
    <meta name="author" content={AUTHOR} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
