---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Memoria" description="This page does not exist. Go back to the Memoria home page or the docs." path="/404" noindex>
  <section class="wrap py-20">
    <h1 class="text-4xl font-extrabold">Page not found</h1>
    <p class="mt-4 text-muted">That address does not match any page on this site.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn" href="/docs">Docs</a>
      <a class="btn" href="/get-started">Get started</a>
    </div>
  </section>
</Layout>
